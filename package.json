{
  "name": "shailesh-stha-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "check:content": "node scripts/check-content.mjs",
    "check:content:strict": "node scripts/check-content.mjs --strict",
    "design:check": "node ../../_design-system/tools/design.mjs check .",
    "pretest": "node scripts/check-content.mjs && node ../../_design-system/tools/design.mjs check .",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "postinstall": "wrangler types"
  },
  "dependencies": {
    "isbot": "^5.1.36",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@react-router/dev": "^8.5.1",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.160.0"
  }
}
